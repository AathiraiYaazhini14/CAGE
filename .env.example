# CAGE Security Configuration

# Set to true to enforce Bearer JWT authentication on API endpoints (/scan, /analyze, /logs, /stats, /demo/*)
# Set to false to disable authentication enforcement for legacy compatibility and testing
CAGE_AUTH_REQUIRED=true

# JWT signing secret (use a secure random string in production)
JWT_SECRET=cage-super-secret-jwt-key-minimum-32-characters-change-in-prod

# Google Gemini API Integration (PASTE YOUR GEMINI API KEY BELOW)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Anthropic LLM Integration (optional secondary fallback)
ANTHROPIC_API_KEY=

# Detector selection: 'v2_final' (production ablated stacker) or 'v1' (legacy baseline)
CAGE_DETECTOR=v2_final
